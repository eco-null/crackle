{
  "name": "Crackle",
  "short_name": "Crackle",
  "description": "A photoreal turntable for the big screen. Spotify, YouTube and your own files, with synced lyrics.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#17130f",
  "theme_color": "#17130f",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
